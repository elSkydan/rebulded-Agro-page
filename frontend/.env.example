# URL of the Express backend (server-side only, used by the /api proxy)
BACKEND_URL=http://localhost:3000

# Public site URL — used for canonical links, Open Graph, sitemap, robots
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# City the landing page sells to (must exist in the backend `cities` table)
NEXT_PUBLIC_DEFAULT_CITY_ID=1

# Contact phone in tel: format and its display form
NEXT_PUBLIC_PHONE=+380679020326
NEXT_PUBLIC_PHONE_DISPLAY=+38 (067) 902-03-26

# Optional: GA4 Measurement ID (format G-XXXXXXXXXX), from
# Google Analytics → Admin → Data Streams → your web stream.
# Leave unset to ship with no analytics script at all.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Contact email (privacy policy / footer)
NEXT_PUBLIC_CONTACT_EMAIL=info@agro-aggregator.ua

# Google Business Profile reviews URL (replace stub when listing is live)
NEXT_PUBLIC_GOOGLE_REVIEWS_URL=https://www.google.com/maps/search/?api=1&query=Agro+Aggregator+Kharkiv

# Telegram bot deep-link for contractors
NEXT_PUBLIC_CONTRACTOR_BOT_URL=https://t.me/AgroAggregatorBot?start=contractor

# Legal entity stubs (replace before relying on them legally)
NEXT_PUBLIC_LEGAL_ENTITY_NAME=ФОП «Agro Aggregator» (чернетка)
NEXT_PUBLIC_LEGAL_EDRPOU=0000000000
NEXT_PUBLIC_LEGAL_ADDRESS=м. Харків, Україна (юридична адреса — уточнюється)
