# URL of the Express backend (server-side only, used by the /api proxy)
BACKEND_URL=http://localhost:3000

# Public site URL — used for canonical links, Open Graph, sitemap, robots
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# City the landing page sells to (must exist in the backend `cities` table)
NEXT_PUBLIC_DEFAULT_CITY_ID=1

# Contact phone in tel: format and its display form
NEXT_PUBLIC_PHONE=+380000000000
NEXT_PUBLIC_PHONE_DISPLAY=+38 (000) 000-00-00
